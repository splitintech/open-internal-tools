{
  "name": "@splitin/group-share",
  "version": "0.1.0",
  "description": "Mint a private subdomain that opens only for invite-list members on a group's IP allowlist.",
  "keywords": [
    "share",
    "subdomain",
    "preview",
    "acl",
    "cidr",
    "gateway",
    "invite",
    "typescript"
  ],
  "author": "SplitInTech, @ojchavan",
  "license": "MIT",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/group-share#readme",
  "bugs": {
    "url": "https://github.com/splitintech/open-internal-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "group-share"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "group-share": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "require": "./dist/identity.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "ui",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node examples/local-preview/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
