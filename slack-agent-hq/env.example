# Copy to .env in this folder. Never commit real tokens.
# Each Slack app is a separate bot user. Fill only the specialists you run.

# Router (@router) — required to open project threads
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-
SLACK_BOT_ID=

# Optional specialists (each is its own Slack app / bot token)
TRIAGE_SLACK_BOT_TOKEN=
TRIAGE_SLACK_SIGNING_SECRET=
TRIAGE_SLACK_APP_TOKEN=
TRIAGE_SLACK_BOT_ID=

CI_SLACK_BOT_TOKEN=
CI_SLACK_SIGNING_SECRET=
CI_SLACK_APP_TOKEN=
CI_SLACK_BOT_ID=

INBOX_SLACK_BOT_TOKEN=
INBOX_SLACK_SIGNING_SECRET=
INBOX_SLACK_APP_TOKEN=
INBOX_SLACK_BOT_ID=

WATCHDOG_SLACK_BOT_TOKEN=
WATCHDOG_SLACK_SIGNING_SECRET=
WATCHDOG_SLACK_APP_TOKEN=
WATCHDOG_SLACK_BOT_ID=

# GitHub / Railway / other webhook secrets (names come from config/integrations.yaml secret_env)
GITHUB_WEBHOOK_SECRET=
RAILWAY_WEBHOOK_SECRET=
PORT=3000

# Paths (defaults work if you run from this folder)
# SLACK_AGENT_HQ_ROOT=
# PROJECT_DB_PATH=
# CONFIG_DIR=
# MEMORY_ROOT=
# SplitIn repo root so @ci seo-drift can run `npm run check:sitemap`
# SPLITIN_ROOT=
# SEO_CHECK_CWD=

# agent-router → HQ job status (POST /hooks/jobs). Empty = allow unsigned (local only).
# AGENT_ROUTER_JOBS_SECRET=

# Extra IPs for inbox auth: none (comma-separated). YAML allowlist is the default.
# INBOX_WEBHOOK_ALLOWLIST=
