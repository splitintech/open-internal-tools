{
  "name": "@splitin/in-app-otp",
  "version": "0.1.0",
  "description": "Framework-neutral in-app OTP handoff primitives for marketplace verification flows.",
  "keywords": [
    "otp",
    "pin",
    "verification",
    "handoff",
    "marketplace",
    "react",
    "typescript",
    "supabase",
    "django",
    "express"
  ],
  "author": "SplitInTech, @ojchavan",
  "license": "MIT",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/in-app-otp#readme",
  "bugs": {
    "url": "https://github.com/splitintech/open-internal-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "in-app-otp"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./adapters/supabase": {
      "types": "./dist/adapters/supabase.d.ts",
      "import": "./dist/adapters/supabase.js",
      "require": "./dist/adapters/supabase.cjs"
    },
    "./adapters/rest": {
      "types": "./dist/adapters/rest.d.ts",
      "import": "./dist/adapters/rest.js",
      "require": "./dist/adapters/rest.cjs"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
