{
  "name": "@splitin/verification-adapter-sdk",
  "version": "0.1.0-beta.0",
  "description": "Provider-neutral verification adapter contracts, schemas, manifests, and conformance kit.",
  "license": "MIT",
  "author": "SplitInTech, @ojchavan",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/verification-adapter-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "verification-adapter-sdk/packages/verification-adapter-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "require": "./dist/conformance.cjs"
    },
    "./fakes": {
      "types": "./dist/fakes.d.ts",
      "import": "./dist/fakes.js",
      "require": "./dist/fakes.cjs"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md", "package.json"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.18.0"
  },
  "devDependencies": {
    "fast-check": "^4.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
