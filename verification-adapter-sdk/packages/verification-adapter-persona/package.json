{
  "name": "@splitin/verification-adapter-persona",
  "version": "0.1.0-beta.0",
  "description": "Official Persona adapter for the Universal Open-Source Verification Adapter SDK. Human IDV, KYB, associated people, and ownership review.",
  "license": "MIT",
  "author": "SplitInTech, @ojchavan",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/verification-adapter-sdk/packages/verification-adapter-persona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "verification-adapter-sdk/packages/verification-adapter-persona"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md", "package.json"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@splitin/verification-adapter-sdk": "0.1.0-beta.0"
  },
  "peerDependencies": {
    "persona": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "persona": { "optional": true }
  },
  "optionalPeerDependencies": {
    "persona": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
