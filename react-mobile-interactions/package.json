{
  "name": "@splitin/react-mobile-interactions",
  "version": "0.1.0",
  "description": "Reusable React primitives for mobile gestures, native motion, route transitions, and overlay back handling.",
  "keywords": [
    "react",
    "mobile",
    "gestures",
    "swipe",
    "swipeable-tabs",
    "edge-swipe",
    "back-navigation",
    "mobile-navigation",
    "route-transition",
    "sheet-transition",
    "overlay",
    "modal",
    "dialog",
    "native-motion",
    "framer-motion",
    "haptics",
    "touch",
    "pwa",
    "ios",
    "android",
    "typescript",
    "react-hooks"
  ],
  "author": "SplitInTech, @ojchavan",
  "license": "MIT",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/react-mobile-interactions#readme",
  "bugs": {
    "url": "https://github.com/splitintech/open-internal-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "react-mobile-interactions"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
