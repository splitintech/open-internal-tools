{
  "name": "@splitin/airdrop-qr",
  "version": "0.2.0",
  "description": "Turn any URL catalog into offline self-contained HTML cards with embedded SVG QR codes for AirDrop sharing.",
  "keywords": [
    "qr",
    "qrcode",
    "airdrop",
    "html",
    "offline",
    "svg",
    "cli",
    "typescript"
  ],
  "author": "SplitInTech, @ojchavan",
  "license": "MIT",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/airdrop-qr#readme",
  "bugs": {
    "url": "https://github.com/splitintech/open-internal-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "airdrop-qr"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "airdrop-qr": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
