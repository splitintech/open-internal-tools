{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@splitin/jpmc-zelle-quick-pay": [
        "./src/index.ts"
      ],
      "@splitin/jpmc-zelle-quick-pay/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples"
  ]
}
